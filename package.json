{
  "name": "crypto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "db:create": "npx wrangler d1 create crypto1-db",
    "db:migrate:local": "npx wrangler d1 migrations apply crypto1-db --local",
    "db:migrate:remote": "npx wrangler d1 migrations apply crypto1-db --remote"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  }
}

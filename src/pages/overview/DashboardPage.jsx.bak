          accent="#FF5CA8"
          loading={loading}
        />
        <MetricCard
          label="BTC / ETH"
          value={`$${(priceHistory.length > 0 ? priceHistory[priceHistory.length-1].price : 0).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 })}`}
          subtitle={`BTC ${markets.find(a=>a.symbol==='BTC')?.price || 0 ? `$${(markets.find(a=>a.symbol==='BTC')!.price||0).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 })}` : '—'}`}
          icon={<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>}
          loading={loading}
        />
      </div>

        const eth = m.find((a) => a.symbol === 'ETH');
        const pts = btc?.history?.slice(-30) || [];
        const btcPrice = pts.length > 0 ? pts[pts.length - 1].price : 0;
        setPriceHistory(pts);
      } catch (err) {
        console.error(err);
      }
    }
    loadData();
  }, []);

  const watchlistIds = watchlist.map((w) => w.assetId);
  const topGainers = useMemo(() => [...markets].filter(Boolean).sort((a, b) => b.change24 - a.change24).slice(0, 5), [markets]);
  const topLosers = useMemo(() => [...markets].filter(Boolean).sort((a, b) => a.change24 - b.change24).slice(0, 5), [markets]);
  const trending = useMemo(() => [...markets].filter(Boolean).sort((a, b) => Math.abs(b.change24) - Math.abs(a.change24)).slice(0, 5), [markets]);

  if (loading) {
    return <div className="page-content"><GlassCard><div className="skeleton-grid" /></GlassCard></div>;
  }

  return (
    <div className="page-content">
      <GlassCard className="page-header">
        <h1>Dashboard</h1>
        <p className="page-subtitle">Real-time overview of simulated crypto market data</p>
      </GlassCard>

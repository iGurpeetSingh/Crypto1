                <div className="table-cell table-header-cell sortable">24h Change</div>
              </div>
              {trending.map((a) => (
                <div key={a.id} className="table-row">
                  <div className="table-cell">
                    <div className="asset-cell">
                      <span className="asset-icon">{a.symbol.charAt(0)}</span>
